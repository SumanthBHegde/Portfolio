---
// Backdrop canvas for the hero. Purely decorative → aria-hidden + non-interactive.
---

<div class="signal" aria-hidden="true">
  <canvas id="signal-canvas"></canvas>
</div>

<style>
  .signal {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    /* soft vignette only at the very edges; the field stays clearly visible */
    -webkit-mask-image: radial-gradient(
      150% 130% at 50% 40%,
      #000 82%,
      transparent 100%
    );
    mask-image: radial-gradient(
      150% 130% at 50% 40%,
      #000 82%,
      transparent 100%
    );
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  // The signature is the 2D "pointing constellations": a field of drifting points
  // across the whole sidebar that link up near the pointer. (No WebGL/OGL.)
  import { initSignal2D } from './signal2d.ts';
  const c = document.getElementById('signal-canvas');
  if (c instanceof HTMLCanvasElement) initSignal2D(c);
</script>
